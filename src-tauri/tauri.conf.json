{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hypnofy",
  "version": "0.1.0",
  "identifier": "app.hypnofy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hypnofy",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' asset: http://asset.localhost blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
