{
  "name": "hypnofy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "node scripts/tauri.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:lint": "node scripts/build-worker.mjs --lint",
    "worker:smoke": "node scripts/inference-smoke.mjs",
    "test:protocol": "cargo test --manifest-path src-tauri/Cargo.toml -p hypnofy-inference-protocol",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src && node scripts/check-boundaries.mjs",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{json,ts}\"",
    "rpc:generate": "node scripts/rpc.mjs",
    "rpc:check": "node scripts/rpc.mjs --check",
    "dev:exe": "node scripts/build-dev.mjs",
    "native:lint": "node scripts/build-worker.mjs --workspace --lint",
    "native:test": "node scripts/build-worker.mjs --workspace --test",
    "native:doc": "node scripts/build-worker.mjs --doc",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@lucide/svelte": "1.66.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "bits-ui": "2.19.2",
    "effect": "4.1.1",
    "svelte": "5.57.0",
    "taurpc": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
